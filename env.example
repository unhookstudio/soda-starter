# Application
PROJECT_NAME=MyApp
FRONTEND_URL=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-value
JWT_SIGNING_KEY=replace-with-an-independent-long-random-value
JWT_AUDIENCE=soda-starter
JWT_ISSUER=soda-starter
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
BROWSER_REFRESH_COOKIE_SECURE=False
NINJA_NUM_PROXIES=1
CONTACTS_RATE_LIMIT_SEARCH=60/m

# PostgreSQL
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=django_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Background jobs are stored in PostgreSQL by Procrastinate
EXPORT_STALE_AFTER_SECONDS=2100
TASK_HISTORY_RETENTION_HOURS=336
TASK_FAILURE_RETENTION_HOURS=2160

# S3-compatible private media storage (Cloudflare R2 works)
R2_ACCESS_KEY_ID=replace-with-storage-access-key
R2_SECRET_ACCESS_KEY=replace-with-storage-secret-key
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
R2_REGION_NAME=auto
R2_PRIVATE_BUCKET_NAME=private-media
EXPORT_RETENTION_DAYS=7

AVATAR_SIGNED_URL_TTL_SECONDS=900
UPLOAD_IMAGE_MAX_BYTES=10485760
UPLOAD_IMAGE_MAX_FILES_PER_REQUEST=20
UPLOAD_IMAGE_MAX_TOTAL_BYTES=52428800

# Transactional email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=MyApp <noreply@example.com>

# Production proxy/security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Production Compose interpolation (put these in the shell or a separate
# Compose environment file, not in the application env file)
APP_IMAGE=ghcr.io/example/myapp:replace-with-immutable-tag
DOMAIN=api.example.com
